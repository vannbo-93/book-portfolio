# انسخ هذا الملف باسم .env وضع فيه القيم الحقيقية. ملف .env لا يُرفع إلى GitHub (موجود في .gitignore)

# المنفذ الذي يعمل عليه الخادم
PORT=4000

# رابط قاعدة البيانات: من MongoDB Atlas (مجاني) أو MongoDB على جهازك
MONGODB_URI=mongodb://127.0.0.1:27017/book-portfolio

# رابط الواجهة: الطلبات تُقبل منه فقط (CORS). عدة روابط مفصولة بفاصلة.
# أثناء التطوير: رابط Vite. على الإنترنت: https://ussainisawi.com,https://www.ussainisawi.com
CLIENT_URL=http://localhost:5173

# development أثناء العمل، production عند الرفع
NODE_ENV=development

# مفتاح سري لتوقيع جلسات الأدمن (32 حرفًا على الأقل). لإنشاء واحد عشوائي:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# مدة بقاء الأدمن مسجلًا قبل طلب الدخول من جديد (بالأيام)
SESSION_DAYS=7

# Cloudinary: مكان تخزين الصور والفيديوهات. من لوحة Cloudinary ← Settings ← API Keys
# الـ API Secret سري مثل كلمة المرور: في .env فقط
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# المجلد داخل حسابك الذي تُرفع إليه ملفات الموقع
CLOUDINARY_FOLDER=book-portfolio

# ===== إشعار بريدي عند وصول رسالة (اختياري) =====
# بدون هذه القيم: الرسائل تُحفظ وتظهر في لوحة التحكم فقط.
# مع بريد Namecheap (Private Email): الخادم mail.privateemail.com والمنفذ 465،
# والمستخدم وكلمة المرور هما بريد الموقع (hello@ussainisawi.com) وكلمة مروره
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
