# انسخ هذا الملف باسم .env وضع فيه القيم الحقيقية. ملف .env لا يُرفع إلى GitHub (موجود في .gitignore)

# المنفذ الذي يعمل عليه الخادم
PORT=4000

# رابط قاعدة البيانات: من MongoDB Atlas (مجاني) أو MongoDB على جهازك
MONGODB_URI=mongodb://127.0.0.1:27017/book-portfolio

# رابط الواجهة: الطلبات تُقبل منه فقط (CORS). أثناء التطوير: رابط Vite
CLIENT_URL=http://localhost:5173

# development أثناء العمل، production عند الرفع
NODE_ENV=development

# مفتاح سري لتوقيع جلسات الأدمن (32 حرفًا على الأقل). لإنشاء واحد:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=4745ce07421795c8f44eada8b516a69f5e7831787c564fc1ae72d494433afae8bd89f7c722f803ffcb7e70d9bc66c29b

# مدة بقاء الأدمن مسجلًا (بالأيام)
SESSION_DAYS=7


# Cloudinary: مكان تخزين الصور والفيديوهات. من لوحة Cloudinary ← Settings ← API Keys
# الـ API Secret سري مثل كلمة المرور: في .env فقط
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# المجلد داخل حسابك الذي تُرفع إليه ملفات الموقع
CLOUDINARY_FOLDER=book-portfolio
